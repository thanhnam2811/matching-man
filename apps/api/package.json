{
    "name": "api",
    "version": "0.0.1",
    "private": true,
    "description": "",
    "license": "UNLICENSED",
    "author": "",
    "scripts": {
        "postinstall": "prisma generate",
        "build": "nest build",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/src/main",
        "start:worker": "nest start --entryFile worker.main",
        "start:worker:dev": "nest start --entryFile worker.main --watch",
        "start:worker:prod": "node dist/src/worker.main",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk ./node_modules/jest/bin/jest.js --runInBand",
        "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json --runInBand --forceExit",
        "prisma:generate": "prisma generate",
        "prisma:migrate:dev": "prisma migrate dev",
        "prisma:migrate:deploy": "prisma migrate deploy",
        "prisma:studio": "prisma studio",
        "openapi:generate": "nest build && node dist/src/generate-openapi.js"
    },
    "dependencies": {
        "@nestjs/bullmq": "^11.0.5",
        "@nestjs/common": "^11.2.7",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.2.7",
        "@nestjs/platform-express": "^11.2.7",
        "@nestjs/schedule": "^6.1.3",
        "@nestjs/swagger": "^11.4.7",
        "@nestjs/throttler": "^6.7.1",
        "@paralleldrive/cuid2": "^2.3.1",
        "@prisma/adapter-pg": "^7.10.1",
        "@prisma/client": "^7.10.1",
        "bullmq": "^6.4.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "helmet": "^8.3.0",
        "ioredis": "^6.0.0",
        "nestjs-pino": "^4.6.1",
        "pg": "^8.23.1",
        "pino": "^10.4.0",
        "pino-http": "^11.0.0",
        "reflect-metadata": "^0.2.2",
        "resend": "^6.34.1",
        "rxjs": "^7.8.2",
        "stripe": "^22.6.2",
        "swagger-ui-express": "^5.0.1"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.24",
        "@nestjs/schematics": "^11.1.0",
        "@nestjs/testing": "^11.2.7",
        "@types/express": "^5.0.6",
        "@types/ioredis": "^5.0.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.19.2",
        "@types/supertest": "^7.2.1",
        "autocannon": "^8.0.0",
        "dotenv": "^16.6.1",
        "jest": "^30.5.2",
        "prisma": "^7.10.1",
        "source-map-support": "^0.5.21",
        "supertest": "^7.3.1",
        "ts-jest": "^29.4.15",
        "ts-loader": "^9.6.2",
        "typescript": "^5.9.3"
    },
    "jest": {
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testEnvironment": "node",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        }
    }
}
